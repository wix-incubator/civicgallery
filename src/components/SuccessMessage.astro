---
interface Props {
  title?: string;
  message?: string;
  class?: string;
}

const {
  title = "Success!",
  message = "Your form has been submitted successfully.",
  class: className = "",
} = Astro.props;
---

<div class={`success-panel ${className}`}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="success-icon"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
    />
  </svg>
  <h3>{title}</h3>
  <p>{message}</p>
  <slot />
</div>

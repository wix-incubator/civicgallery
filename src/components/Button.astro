---
interface Props {
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary";
  class?: string;
}

const { 
  type = "button", 
  variant = "primary",
  class: className = "" 
} = Astro.props;

const variantClasses = {
  primary: "button-primary",
  secondary: "button-secondary",
};

const classes = `site-button ${variantClasses[variant]} ${className}`;
---

<button 
  type={type} 
  class={classes}
>
  <slot />
</button>

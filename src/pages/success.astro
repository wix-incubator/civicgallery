---
import Layout from "../layouts/Layout.astro";
import SuccessMessage from "../components/SuccessMessage.astro";
import Button from "../components/Button.astro";
---

<Layout
  title="Reservation Received | Civic Gallery"
  description="Civic Gallery registration confirmation."
>
  <div class="success-page site-shell">
    <SuccessMessage
      title="Reservation received."
      message="Your gallery registration has been submitted through Wix Headless. The visitor desk can now review your event selection, contact details, and access notes."
    >
      <div class="success-actions">
        <a href="/" class="inline-block">
          <Button variant="primary">Return to Home</Button>
        </a>
      </div>
    </SuccessMessage>
  </div>
</Layout>

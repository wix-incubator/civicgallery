---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Civic Gallery exhibition and event registration powered by Wix Headless forms",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="civic-site">
    <div class="min-h-screen flex flex-col">
      <header class="site-header">
        <div class="site-shell header-inner">
          <a href="/" class="brand-lockup" aria-label="Civic Gallery home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>Civic Gallery</span>
          </a>
          <nav class="header-nav" aria-label="Gallery navigation">
            <a href="/#exhibitions">Exhibitions</a>
            <a href="/#registration">Register</a>
            <a href="https://github.com/wix-incubator/civicgallery" target="_blank" rel="noreferrer">GitHub</a>
          </nav>
        </div>
      </header>

      <main class="grow">
        <slot />
      </main>

      <footer class="site-footer mt-auto">
        <div class="site-shell footer-inner">
          <span>&copy; {new Date().getFullYear()} Civic Gallery</span>
          <span>Powered by Wix Headless | Built with <a href="https://www.wix-headless.dev" target="_blank" rel="noreferrer">wix-headless.dev</a></span>
          <a href="https://github.com/wix-incubator/civicgallery" target="_blank" rel="noreferrer">View source on GitHub</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
